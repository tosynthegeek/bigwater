{
  "name": "bigwater_backend",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/ws": "^8.18.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1082.0",
    "@bull-board/api": "^8.1.0",
    "@bull-board/hono": "^8.1.0",
    "@grammyjs/conversations": "^2.1.1",
    "@grammyjs/storage-redis": "^2.5.1",
    "@privy-io/node": "^0.24.0",
    "bullmq": "^5.79.2",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "grammy": "^1.44.0",
    "hono": "^4.12.27",
    "hono-rate-limiter": "^0.5.3",
    "ioredis": "^5.11.1",
    "nanoid": "^5.1.16",
    "pg": "^8.22.0",
    "postgres": "^3.4.9",
    "uuid": "^14.0.1",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "scripts": {
    "start": "bun index.ts",
    "start:api": "bunx drizzle-kit migrate && bun index.ts",
    "start:bot": "bun run src/telegram/index.ts",
    "lint": "bunx eslint . --ext .ts,.tsx",
    "format": "bunx prettier --check .",
    "format:fix": "bunx prettier --write .",
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && bun build index.ts drizzle.config.ts --outdir=dist --target=bun --splitting",
    "dev": "bun --watch index.ts",
    "db:check": "drizzle-kit push:pg --dry-run",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:generate-custom": "drizzle-kit generate --custom",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio --port=5555",
    "health:check": "curl -sf http://localhost:${PORT:-4000}/health"
  }
}
