NODE_ENV=development
PORT=3000
POSTGRES_USER=dummy
POSTGRES_PASSWORD=dummy
POSTGRES_DB=dummy
DATABASE_URL=postgresql://dummy:dummy@localhost:5432/dummy
CLIENT_URL=http://localhost:3000
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=dummy_redis_password
PRIVY_APP_ID=dummy_app_id
PRIVY_APP_SECRET=dummy_app_secret
TELEGRAM_BOT_TOKEN=telegram_bot_token
AI_SERVICE_API_KEY=dummy_api_key

AWS_BUCKET_NAME=dummy-bucket
AWS_BUCKET_REGION=us-east-1
AWS_ACCESS_KEY=dummy_aws_access_key
AWS_ACCESS_SECRET=dummy_aws_access_secret
AWS_CLOUDFRONT_URL=https://cdn.example.com

# Comma-separated Privy DIDs to grant the admin role on seed. Required for the
# admin panel to have any admin user (see src/db/seed/admins.ts).
ADMIN_PRIVY_DIDS=did:privy:xxxxxxxxxxxxxxxxxxxx

# Demo-only. When "true", new submissions skip the (undeployed) AI verification
# step and go straight to the admin review queue so the submit -> review ->
# approve loop can be demoed end-to-end. Leave unset/false in production.
DEMO_AUTO_REVIEW=false