NODE_ENV=development
PORT=3000
POSTGRES_USER=dummy
POSTGRES_PASSWORD=dummy
POSTGRES_DB=dummy
DATABASE_URL=postgresql://dummy:dummy@localhost:5432/dummy

# --- Auth ---
# Must equal rail1's (bigw-api) JWT_SECRET — verifies the x-rail1-token header
# on GET /api/link-rail1 (see src/middleware/rail1-jwt.ts).
RAIL1_JWT_SECRET=dev-insecure-jwt-secret-change-me

CLIENT_URL=http://localhost:3000,http://localhost:5173
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=dummy_redis_password
PRIVY_APP_ID=dummy_app_id
PRIVY_APP_SECRET=dummy_app_secret
TELEGRAM_BOT_TOKEN=telegram_bot_token
AI_SERVICE_API_KEY=dummy_api_key

AWS_BUCKET_NAME=dummy-bucket
AWS_BUCKET_REGION=us-east-1
AWS_ACCESS_KEY=dummy_aws_access_key
AWS_ACCESS_SECRET=dummy_aws_access_secret
AWS_CLOUDFRONT_URL=https://cdn.example.com
# Optional: set to use any S3-compatible store instead of AWS (MinIO, Cloudflare
# R2, Supabase Storage, Backblaze B2). Leave unset for real AWS S3.
# AWS_S3_ENDPOINT=https://<your-s3-compatible-endpoint>

# Storage driver. "s3" (default) uses the AWS_* config above. "local" writes
# proof images to UPLOAD_DIR on disk and serves them from GET /uploads — a
# zero-dependency store for staging/demo. For "local", PUBLIC_BASE_URL must be
# the API's public origin (e.g. https://<service>.up.railway.app).
# STORAGE_DRIVER=local
# UPLOAD_DIR=/data/uploads
# PUBLIC_BASE_URL=http://localhost:3000

# Single-service deploys can run the Telegram bot inside the API process.
# RUN_BOT_IN_PROCESS=true

# Comma-separated Privy DIDs to grant the admin role on seed. Required for the
# admin panel to have any admin user (see src/db/seed/admins.ts).
ADMIN_PRIVY_DIDS=did:privy:xxxxxxxxxxxxxxxxxxxx

# Demo-only. When "true", new submissions skip the (undeployed) AI verification
# step and go straight to the admin review queue so the submit -> review ->
# approve loop can be demoed end-to-end. Leave unset/false in production.
DEMO_AUTO_REVIEW=false

TALLY_PERIOD_MS=6000000
BANKING_SWEEP_INTERVAL_MS=300000

// AI evaluation
OPENROUTER_API_KEY=dummy
OPENROUTER_MODEL=qwen/qwen3.6-flash